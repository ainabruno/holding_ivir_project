# Copy this file to .env and replace every placeholder before starting the app.
# Never commit the resulting .env file.

DATABASE_URL=mysql://holding_user:holding_password@localhost:3306/holding_ivir
MISTRAL_API_KEY=replace_with_your_mistral_key
JWT_SECRET=replace_with_a_long_random_secret

VITE_APP_ID=replace_with_manus_app_id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://portal.manus.im
OWNER_NAME=Administrator
OWNER_OPEN_ID=replace_with_owner_open_id

BUILT_IN_FORGE_API_URL=https://api.manus.im
BUILT_IN_FORGE_API_KEY=replace_with_forge_key
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im
VITE_FRONTEND_FORGE_API_KEY=replace_with_frontend_forge_key

VITE_APP_TITLE=Holding IVIR - Legal Intelligence Platform
VITE_APP_LOGO=https://replace-with-logo-url.example/logo.png

# Frontend Vite sur 5173 vers FastAPI sur 8000 en développement local.
# En Docker ou en production unifiée, laissez cette variable vide.
VITE_PYTHON_API_URL=http://localhost:8000

NODE_ENV=development
PORT=3000

# Accès API Légifrance via PISTE (créé dans votre compte PISTE).
# En sandbox, les URLs officielles sont celles ci-dessous. Pour la production,
# remplacez-les uniquement par les URLs indiquées par votre application PISTE.
LEGIFRANCE_CLIENT_ID=replace_with_piste_client_id
LEGIFRANCE_CLIENT_SECRET=replace_with_piste_client_secret
PISTE_TOKEN_URL=https://sandbox-oauth.piste.gouv.fr/api/oauth/token
LEGIFRANCE_API_BASE_URL=https://sandbox-api.piste.gouv.fr/dila/legifrance/lf-engine-app

# Jeton Bearer généré par l’administrateur du déploiement pour les opérations sensibles.
ADMIN_API_TOKEN=replace_with_a_long_random_admin_token
